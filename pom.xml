  Where it goes: clone_all.py copies this file into the parent folder, beside the repositories it clones:

      <parent>/pom.xml              this file
      <parent>/drishti-tools/       tools      1st (everything else uses it)
      <parent>/drishti-rachana/     Rachana    2nd (needs tools)
      <parent>/drishti-lake/        Lake       3rd (needs tools)
      <parent>/drishti/             Drishti    last (needs all three; vendors Elements' bundles, which have no Java build)

  In the parent folder:
      mvn                                    the default: clean install, every product in order (installs into your ~/.m2)
      mvn -DskipTests                        a quick build (IntelliJ: the Maven window's "Skip Tests" toggle)
      mvn -Dgoals="clean verify"             build and test, install nothing (each product then needs the one before it in ~/.m2)

  Each product is built by its own Maven wrapper in its own folder, exactly as it is built on its own and in the drill: this file
  only runs them one after another and stops at the first that fails. A product's settings (its .mvn folder) stay its own.
  build_all.py does the same plus Elements and the Python checks.

  IntelliJ: the launchers in run-configs/ (placed beside this file by clone_all.py, and in the source zip):
      platform-clean-install                    Windows: clean install of all four, no tests, trusting the Windows certificate store
      platform-clean-install (Linux, macOS)     the same without the Windows option
  The outer Maven (the one IntelliJ runs) needs the Windows option in its own JVM, which is why the Windows launcher sets it as a VM
  option; this pom passes it on to the four product builds itself.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ash.platform</groupId>
    <artifactId>drishti-platform</artifactId>
    <version>1</version>
    <packaging>pom</packaging>
    <name>Drishti platform: every Java product, in order</name>

    <properties>
        <goals>clean install</goals>
        <!-- IntelliJ's "Skip Tests" toggle and mvn -DskipTests set this; it is passed on to every product's own build -->
        <skipTests>false</skipTests>
        <mvnw>./mvnw</mvnw>
        <!-- JVM options for every product's build; on Windows the profile below trusts the Windows certificate store
             (a corporate proxy's root is there), so Maven Central is reached; -Dplatform.trust= turns it off -->
        <platform.trust></platform.trust>
        <!-- the Python the product builds start (Rachana's build helpers read -Dpython3); on Windows the profile below uses the
             Python launcher `py`, because `python3`/`python` there is often the Microsoft Store stub, not the installed Python -->
        <platform.python></platform.python>
    </properties>

    <profiles>
        <profile>
            <id>windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <mvnw>mvnw.cmd</mvnw>
                <platform.trust>-Djavax.net.ssl.trustStoreType=Windows-ROOT</platform.trust>
                <platform.python>-Dpython3=py</platform.python>
            </properties>
        </profile>
    </profiles>

    <build>
        <defaultGoal>validate</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>1-tools</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/drishti-tools/java</workingDirectory>
                            <executable>${project.basedir}/drishti-tools/java/${mvnw}</executable>
                            <commandlineArgs>-B ${platform.trust} ${platform.python} -DskipTests=${skipTests} ${goals}</commandlineArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>2-rachana</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/drishti-rachana/java</workingDirectory>
                            <executable>${project.basedir}/drishti-rachana/java/${mvnw}</executable>
                            <commandlineArgs>-B ${platform.trust} ${platform.python} -DskipTests=${skipTests} ${goals}</commandlineArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>3-lake</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/drishti-lake/java</workingDirectory>
                            <executable>${project.basedir}/drishti-lake/java/${mvnw}</executable>
                            <commandlineArgs>-B ${platform.trust} ${platform.python} -DskipTests=${skipTests} ${goals}</commandlineArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>4-drishti</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/drishti</workingDirectory>
                            <executable>${project.basedir}/drishti/${mvnw}</executable>
                            <commandlineArgs>-B ${platform.trust} ${platform.python} -DskipTests=${skipTests} ${goals}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
